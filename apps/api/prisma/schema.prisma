// SafariBrain data model — Phase 0/1 scope (Sales Operating System).
//
// Scope note: Section 6 of the master brief lists the full pan-platform
// domain list (marketplace, departures, finance, operations, reviews,
// trade...). Per the phase order in Section 7, this schema only models
// the domains Phase 0/1 needs: Identity, CRM, Content (minimal), Pricing
// (with an immutable snapshot), Products, Sales documents, and Platform
// audit logging. Booking, Marketplace, Departures, Finance, Operations,
// Communications, Reviews, and Trade are added in their respective phases
// so we don't build half-finished tables ahead of the features that use them.
//
// Non-negotiable (§1.8, §6): PriceSnapshot and (later, Phase 2)
// BookingTermsSnapshot are write-once. Nothing may update or delete a row
// in PriceSnapshot after creation — enforced at the application layer in
// the quotes service, since Postgres has no native "insert-only" table
// constraint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity (§6, §3)
// ---------------------------------------------------------------------------

enum UserRole {
  CLIENT
  GUIDE
  OPERATOR
  AGENT
  ADMIN
}

// A tourism-professional Organization is one of three kinds — a company
// running its own trips (OPERATOR, the only kind that existed before this),
// an individual freelance guide selling their own itineraries directly, or
// a travel agent/agency who resells other orgs' inventory (Trade
// marketplace). Modeling a guide/agent as an Organization rather than a
// standalone concept is deliberate reuse: every existing org-scoped
// feature (TourTemplate, Departure/Seat booking, Vehicle fleet, CRM,
// marketplace listing, verification) works for a solo guide's one-person
// "company" with zero new code.
enum OrganizationKind {
  OPERATOR
  GUIDE
  AGENT
}

model Organization {
  id        String            @id @default(cuid())
  name      String
  kind      OrganizationKind  @default(OPERATOR)
  country   String // ISO 3166-1 alpha-2, e.g. "TZ" — §1.7 country is config, not a rebuild
  currency  String // ISO 4217, e.g. "TZS"
  verified  Boolean  @default(false) // Trust domain (§6) collapsed onto the org for Phase 0/1
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  contacts      Contact[]
  tourTemplates TourTemplate[]
  requests      EnquiryRequest[]
  places        Place[]
  integrations  Integration[]
  bookings      Booking[]
  agentBookings Booking[] @relation("AgentBooking")
  aiJobs        AiJob[]
  departures    Departure[]
  reviews       Review[]
  vehicles      Vehicle[]
  supplierConfirmations SupplierConfirmation[]
  vehicleRentalListings   VehicleRentalListing[]
  rentalAgreementsAsOwner VehicleRentalAgreement[] @relation("RentalOwner")
  rentalAgreementsAsRenter VehicleRentalAgreement[] @relation("RentalRenter")
  conversationsA Conversation[] @relation("ConversationOrgA")
  conversationsB Conversation[] @relation("ConversationOrgB")
  messages       Message[]

  @@map("organizations")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  ownedRequests   EnquiryRequest[]   @relation("RequestOwner")
  quoteApprovals  Approval[]
  auditLogEntries AuditLog[]
  tasks           Task[]
  recordedPayments Payment[]
  aiJobsRequested AiJob[] @relation("AiJobRequestedBy")
  aiJobsDecided   AiJob[] @relation("AiJobDecidedBy")
  moderatedReviews Review[]

  @@map("users")
}

// A user's membership in an org carries their role plus scoped permission
// grants — §3 requires finance/safety actions to need explicit grants, not
// a single "Admin can do everything" flag.
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole
  permissions    String[] // Permission enum values from @safaribrain/shared
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// CRM (§6, §4.7)
// ---------------------------------------------------------------------------

enum LeadSourceChannel {
  WEB
  WHATSAPP
  EMAIL
  PHONE
  REFERRAL
  WALK_IN
}

enum RequestStage {
  NEW
  QUOTED
  NEGOTIATING
  BOOKED
  COMPLETED
  LOST
}

// A deduplicated client/prospect. One contact can raise multiple enquiries
// over time — §10 acceptance criterion 1 ("one deduplicated contact").
model Contact {
  id             String   @id @default(cuid())
  organizationId String
  fullName       String
  email          String?
  phone          String?
  whatsapp       String?
  country        String? // traveler's home country, for nationality-based pricing/analytics
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     EnquiryRequest[]

  @@unique([organizationId, email])
  @@index([organizationId, phone])
  @@map("contacts")
}

// The "requests" table from §6 — an inbound enquiry, custom or marketplace.
model EnquiryRequest {
  id             String            @id @default(cuid())
  organizationId String
  contactId      String
  ownerId        String? // salesperson assigned — §4.7 "team assignment"
  source         LeadSourceChannel
  stage          RequestStage      @default(NEW)
  partySize      Int               @default(1)
  budgetTier     String? // e.g. "BUDGET" | "MID" | "LUXURY" — free text for now, enum once marketplace filters land
  preferredStart DateTime?
  preferredEnd   DateTime?
  interests      String[]
  notes          String?
  consentGiven   Boolean           @default(false) // §9 non-functional: consent/retention records
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  owner        User?           @relation("RequestOwner", fields: [ownerId], references: [id])
  quotes       Quote[]
  tasks        Task[]
  pipelineLog  PipelineEvent[]
  bookings     Booking[]
  aiJobs       AiJob[]

  @@index([organizationId, stage])
  @@map("enquiry_requests")
}

model Task {
  id          String    @id @default(cuid())
  requestId   String
  assigneeId  String?
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  request  EnquiryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assignee User?          @relation(fields: [assigneeId], references: [id])

  @@map("tasks")
}

// Append-only activity trail per request — powers the "visual pipeline" (§4.7)
// and doubles as part of the audit trail for how a deal moved.
model PipelineEvent {
  id        String       @id @default(cuid())
  requestId String
  stage     RequestStage
  note      String?
  createdAt DateTime     @default(now())

  request EnquiryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("pipeline_events")
}

// ---------------------------------------------------------------------------
// Content (§6, §4.8) — minimal: enough to price a park fee and describe a stop
// ---------------------------------------------------------------------------

model Place {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  country        String
  kind           String // "NATIONAL_PARK" | "CONSERVATION_AREA" | "TOWN" | ...
  description    String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  feeRules     ParkFeeRule[]
  itineraryUse ItineraryDay[]

  @@map("places")
}

// ---------------------------------------------------------------------------
// Pricing (§6, §4.5) — official-source fee governance, not scraping-as-truth
// ---------------------------------------------------------------------------

// A single priced category for a place: e.g. "Serengeti / non-resident adult
// / vehicle / 24hr". Automated fee-change *detection* (§4.5) is a Phase 4
// concern (needs the source-evidence + admin-approval workflow); Phase 1
// only needs admin-entered fees with a source date so quotes can cite them.
model ParkFeeRule {
  id           String    @id @default(cuid())
  placeId      String
  label        String
  residency    String // "RESIDENT" | "NON_RESIDENT" | "EAST_AFRICAN"
  ageBand      String? // "ADULT" | "CHILD" | "INFANT"
  unit         String // "PER_PERSON_PER_DAY" | "PER_VEHICLE_PER_ENTRY" | ...
  amount       Decimal   @db.Decimal(12, 2)
  currency     String
  sourceUrl    String? // §4.5 "source URL, retrieval timestamp"
  sourceAsOf   DateTime // "price as of [date]" shown to travelers — §4.5
  effectiveFrom DateTime @default(now())
  effectiveTo  DateTime?
  createdAt    DateTime  @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([placeId, residency])
  @@map("park_fee_rules")
}

// Write-once. Frozen at the moment a quote is ACCEPTED (§1.8, §6). The
// application layer must never UPDATE or DELETE a row here — a later edit
// to TourTemplate/ParkFeeRule must never change what an accepted quote shows.
model PriceSnapshot {
  id           String   @id @default(cuid())
  quoteId      String   @unique
  breakdown    Json // PriceBreakdownDto shape from @safaribrain/shared
  totalPrice   Decimal  @db.Decimal(12, 2)
  currency     String
  frozenAt     DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("price_snapshots")
}

// ---------------------------------------------------------------------------
// Products (§6, §4.4) — reusable itinerary building blocks
// ---------------------------------------------------------------------------

model TourTemplate {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  summary        String?
  durationDays   Int
  // Phase 3 (§7) marketplace: a template an org has opted to show to
  // travelers browsing without an account, cross-organization. Off by
  // default — a template only appears once an operator deliberately lists
  // it, never automatically just by existing.
  publiclyListed Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     TemplateVersion[]
  quotes       Quote[]
  departures   Departure[]
  reviews      Review[]

  @@map("tour_templates")
}

model TemplateVersion {
  id             String   @id @default(cuid())
  tourTemplateId String
  versionNumber  Int
  termsMarkdown  String? // cancellation terms etc. — frozen into quotes at acceptance
  createdAt      DateTime @default(now())

  tourTemplate TourTemplate   @relation(fields: [tourTemplateId], references: [id], onDelete: Cascade)
  days         ItineraryDay[]

  @@unique([tourTemplateId, versionNumber])
  @@map("template_versions")
}

model ItineraryDay {
  id                String  @id @default(cuid())
  templateVersionId String
  dayNumber         Int
  placeId           String?
  title             String
  description       String?
  mealsIncluded     String[] // "BREAKFAST" | "LUNCH" | "DINNER"

  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  place           Place?          @relation(fields: [placeId], references: [id])

  @@unique([templateVersionId, dayNumber])
  @@map("itinerary_days")
}

// ---------------------------------------------------------------------------
// Sales documents (§6, §4.4, §9) — quote → approval → proposal → acceptance
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  CHANGES_REQUESTED
  EXPIRED
  DECLINED
}

model Quote {
  id                String      @id @default(cuid())
  requestId         String
  tourTemplateId    String?
  templateVersionId String? // pinned so a later template edit can't change what's already quoted
  residency         String      @default("NON_RESIDENT")
  status            QuoteStatus @default(DRAFT)
  currency          String
  marginPercent     Decimal     @db.Decimal(5, 2) @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  request      EnquiryRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tourTemplate TourTemplate?    @relation(fields: [tourTemplateId], references: [id])
  versions     QuoteVersion[]
  approvals    Approval[]
  priceSnapshot PriceSnapshot?
  proposalLink ProposalLink?
  booking      Booking?

  @@map("quotes")
}

// Every edit to a quote creates a new version — never mutate a sent quote
// in place (§4.7 "quote_versions").
model QuoteVersion {
  id         String   @id @default(cuid())
  quoteId    String
  versionNo  Int
  breakdown  Json // PriceBreakdownDto — the live (mutable-until-accepted) working copy
  totalPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, versionNo])
  @@map("quote_versions")
}

// A manager approving an under-margin (or any) quote — §10 acceptance
// criterion 4: "the approval is audited."
model Approval {
  id         String   @id @default(cuid())
  quoteId    String
  approverId String
  decision   String // "APPROVED" | "REJECTED"
  reason     String?
  createdAt  DateTime @default(now())

  quote    Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  approver User  @relation(fields: [approverId], references: [id])

  @@map("approvals")
}

// Public, tokenized link a client opens to view/accept a proposal — no
// login required, per §5 "mobile, low-bandwidth, WhatsApp-first".
model ProposalLink {
  id          String    @id @default(cuid())
  quoteId     String    @unique
  token       String    @unique @default(cuid())
  openedAt    DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("proposal_links")
}

// ---------------------------------------------------------------------------
// Booking (§6, §4.2, §4.3, §7 Phase 2) — deliberately minimal: a booking is
// created the moment a quote is accepted, alongside its PriceSnapshot.
// Payments here are staff-recorded (bank transfer/cash/manual mobile money)
// rather than gateway-integrated — no payment provider has been chosen yet
// (§11 open decision), and an admin can add real gateway credentials via
// Integrations (§4.9) whenever that's resolved. When that happens, an
// automated payment_intents/webhook flow writes into this same Payment
// table rather than needing a redesign.
// ---------------------------------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  PAID
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingChannel {
  RETAIL
  TRADE
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  requestId      String
  // Nullable — §1's "two buying modes": a quote-negotiated booking sets
  // quoteId (QuotesService.accept); an instant seat-map booking on a fixed
  // Departure sets departureId instead and never has a quote at all.
  quoteId        String?       @unique
  departureId    String?
  status         BookingStatus @default(PENDING)
  currency       String
  totalPrice     Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @db.Decimal(12, 2) @default(0)
  // Trade marketplace: a TRADE booking was made by another organization's
  // agent buying seats on this departure at netPricePerSeat on behalf of
  // their own end client, rather than the traveler booking directly.
  // `retailTotalPrice` snapshots what the same seats would have cost at
  // the departure's public price at booking time, so the agent's margin
  // (retailTotalPrice - totalPrice) is knowable later even after the
  // departure's own prices change.
  channel             BookingChannel @default(RETAIL)
  agentOrganizationId String?
  retailTotalPrice    Decimal?       @db.Decimal(12, 2)
  // The e-ticket/QR and the public trip-status page both key off this
  // token rather than the booking's own id, same pattern as ProposalLink.
  ticketToken    String        @unique @default(cuid())
  // Trip-delivery logistics (§7 Phase 2 "guide manifests") — plain text, not
  // a User FK: guides/drivers are frequently contracted, not platform
  // account holders. Staff-only; never exposed on the public booking page.
  guideName      String?
  guidePhone     String?
  pickupNotes    String?
  // The vehicle assigned for this trip (§4.3 "vehicle compliance") — a
  // plain FK to the org's own fleet, staff-only, alongside the guide fields.
  vehicleId      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentOrganization Organization?      @relation("AgentBooking", fields: [agentOrganizationId], references: [id])
  request       EnquiryRequest         @relation(fields: [requestId], references: [id])
  quote         Quote?                 @relation(fields: [quoteId], references: [id])
  departure     Departure?             @relation(fields: [departureId], references: [id])
  vehicle       Vehicle?               @relation(fields: [vehicleId], references: [id])
  termsSnapshot BookingTermsSnapshot?
  travelers     Traveler[]
  payments      Payment[]
  seats         Seat[]
  review        Review?
  supplierConfirmations SupplierConfirmation[]

  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Fleet (§4.3 "vehicle compliance") — the org's own vehicles, tracked for
// insurance/inspection expiry so an expired vehicle isn't quietly assigned
// to a trip. Expiry state is computed at read time (same lazy-check pattern
// Departure hold expiry uses) rather than needing a background job.
// ---------------------------------------------------------------------------

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

model Vehicle {
  id                 String        @id @default(cuid())
  organizationId     String
  name               String // e.g. "Land Cruiser #2"
  registrationNumber String
  capacity           Int
  status             VehicleStatus @default(ACTIVE)
  insuranceExpiry    DateTime?
  inspectionExpiry   DateTime?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  rentalListing VehicleRentalListing?

  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Vehicle rental exchange (§6 Trade) — an owner org publishes a fleet
// vehicle as rentable by other organizations (another operator short a
// vehicle, a guide who owns no vehicle, an agent assembling a package),
// under a per-rental agreement rather than an instant "book now" — vehicle
// hire in this business is a negotiated commercial arrangement (deposit,
// driver, fuel/mileage terms), not a fixed retail price like a seat.
// ---------------------------------------------------------------------------

// UNLISTED keeps a vehicle out of the shared exchange browse list entirely
// — the owner can still hand a specific renter the listing id directly
// (a "private network" arrangement) without building a separate ACL.
enum RentalListingVisibility {
  LISTED
  UNLISTED
}

model VehicleRentalListing {
  id             String                  @id @default(cuid())
  organizationId String
  vehicleId      String                  @unique // one active listing per vehicle, keeps availability unambiguous
  dailyRate      Decimal                 @db.Decimal(12, 2)
  currency       String
  visibility     RentalListingVisibility @default(LISTED)
  notes          String?
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  agreements   VehicleRentalAgreement[]

  @@map("vehicle_rental_listings")
}

enum RentalAgreementStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model VehicleRentalAgreement {
  id                 String                 @id @default(cuid())
  listingId          String
  ownerOrganizationId  String // denormalized from listing at request time so ownership survives a listing edit
  renterOrganizationId String
  startDate          DateTime
  endDate            DateTime
  dailyRate          Decimal                @db.Decimal(12, 2) // snapshot from the listing at request time
  totalPrice         Decimal                @db.Decimal(12, 2)
  currency           String
  message            String?
  status             RentalAgreementStatus  @default(PENDING)
  respondedAt        DateTime?
  createdAt          DateTime               @default(now())

  listing          VehicleRentalListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ownerOrganization  Organization       @relation("RentalOwner", fields: [ownerOrganizationId], references: [id])
  renterOrganization Organization       @relation("RentalRenter", fields: [renterOrganizationId], references: [id])

  @@map("vehicle_rental_agreements")
}

// ---------------------------------------------------------------------------
// Org-to-org messaging (§6 Trade "chat like a WhatsApp group... knowing
// each other") — deliberately B2B only: an operator, guide, agent, or
// vehicle owner messaging another organization they're trading with.
// Traveler-facing chat is explicitly NOT built here — travelers have no
// platform account at all in this system (public tokenized links only,
// §5), so a "safari group chat" for them would need a traveler identity
// model built first; see ARCHITECTURE.md "Deliberately not built yet".
// ---------------------------------------------------------------------------

model Conversation {
  id String @id @default(cuid())
  // Unordered pair of organizations, normalized (orgAId < orgBId as
  // strings) at creation time so "start a conversation" is idempotent —
  // reuses the existing thread instead of creating a duplicate one.
  organizationAId String
  organizationBId String
  createdAt       DateTime @default(now())

  organizationA Organization @relation("ConversationOrgA", fields: [organizationAId], references: [id], onDelete: Cascade)
  organizationB Organization @relation("ConversationOrgB", fields: [organizationBId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([organizationAId, organizationBId])
  @@map("conversations")
}

model Message {
  id                String   @id @default(cuid())
  conversationId    String
  senderOrganizationId String
  senderUserId      String?
  body              String
  createdAt         DateTime @default(now())

  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderOrganization Organization @relation(fields: [senderOrganizationId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Supplier confirmations (§4.3 "calendar/supplier confirmations") — a
// per-booking checklist of the lodges/permits/transport an operator needs a
// yes from before a trip is truly ready, independent of payment status.
// ---------------------------------------------------------------------------

enum SupplierConfirmationStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model SupplierConfirmation {
  id             String                     @id @default(cuid())
  organizationId String
  bookingId      String
  supplierName   String
  supplierType   String? // free text, e.g. "Lodge", "Park permit", "Transport"
  status         SupplierConfirmationStatus @default(PENDING)
  referenceCode  String?
  neededBy       DateTime?
  confirmedAt    DateTime?
  notes          String?
  createdAt      DateTime                   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("supplier_confirmations")
}

// ---------------------------------------------------------------------------
// Departures (§6, §4.2, §7 Phase 3) — the second of the two buying modes §1.2
// requires: fixed, joinable safaris a traveler can instantly book a seat on,
// alongside (not instead of) the custom quote→negotiate→book flow above.
// Booking, Traveler, Payment, BookingTermsSnapshot are all reused as-is —
// an instant seat-map booking is still a Booking row, just one with
// departureId set and quoteId null, so every existing operator tool
// (BookingPanel, payments, guide manifest, receipt/e-ticket PDFs) works on
// it with no new code.
// ---------------------------------------------------------------------------

enum DepartureStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Departure {
  id             String          @id @default(cuid())
  organizationId String
  tourTemplateId String
  departureDate  DateTime
  currency       String
  pricePerSeat   Decimal         @db.Decimal(12, 2)
  totalSeats     Int
  status         DepartureStatus @default(OPEN)
  // Trade/wholesale marketplace (§6 Trade, operator/guide/agent B2B): a
  // departure only appears to other organizations' agents once the owning
  // org opts it in (tradeVisible) and sets a net seat price lower than
  // pricePerSeat — same "off by default, deliberate opt-in" pattern as
  // TourTemplate.publiclyListed. Seats themselves are a single shared pool
  // — a seat sold via the trade channel is the exact same Seat row as one
  // sold retail, so there is no separate "trade inventory" to double-book.
  netPricePerSeat Decimal?       @db.Decimal(12, 2)
  tradeVisible    Boolean        @default(false)
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourTemplate TourTemplate @relation(fields: [tourTemplateId], references: [id], onDelete: Cascade)
  seats        Seat[]
  bookings     Booking[]

  @@map("departures")
}

enum SeatType {
  WINDOW
  AISLE
  FRONT
  ACCESSIBLE
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

// Atomicity for hold acquisition lives in DeparturesService (Postgres
// SERIALIZABLE transaction, not a DB constraint — Postgres has no native
// "unique while not expired" constraint). Expiry is lazy: every read path
// treats `status=HELD && heldUntil <= now()` as available rather than
// requiring a background sweep job, so a seat is effectively released the
// instant its hold lapses without needing reliable cron infrastructure.
model Seat {
  id          String     @id @default(cuid())
  departureId String
  label       String // e.g. "1A"
  type        SeatType
  status      SeatStatus @default(AVAILABLE)
  heldUntil   DateTime?
  holderToken String? // opaque, client-generated — same trust model as ProposalLink/Booking.ticketToken
  bookingId   String?

  departure Departure @relation(fields: [departureId], references: [id], onDelete: Cascade)
  booking   Booking?  @relation(fields: [bookingId], references: [id])

  @@unique([departureId, label])
  @@map("seats")
}

// Write-once — same discipline as PriceSnapshot (§1.8, §6). Frozen at the
// instant the booking is created so a later edit to the source
// TourTemplate/TemplateVersion can never change what a confirmed
// traveler's itinerary/terms show.
model BookingTermsSnapshot {
  id            String   @id @default(cuid())
  bookingId     String   @unique
  itinerary     Json // { title, durationDays, days: [...] } snapshot of the accepted template version
  termsMarkdown String?
  frozenAt      DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_terms_snapshots")
}

model Traveler {
  id             String    @id @default(cuid())
  bookingId      String
  fullName       String
  dateOfBirth    DateTime?
  passportNumber String?
  createdAt      DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("travelers")
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  MOBILE_MONEY_MANUAL
}

model Payment {
  id           String        @id @default(cuid())
  bookingId    String
  amount       Decimal       @db.Decimal(12, 2)
  currency     String
  method       PaymentMethod
  reference    String? // bank transfer reference, receipt number, etc.
  recordedById String?
  createdAt    DateTime      @default(now())

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation(fields: [recordedById], references: [id])

  @@map("payments")
}

// ---------------------------------------------------------------------------
// Reviews (§6, §4.1, §7 Phase 3 gate: "post-trip review invite and
// moderation"). A review can only be submitted against a COMPLETED
// booking — reusing the trip's own contact identity rather than a
// separate review-account system, consistent with §5's no-login
// principle. Every review starts PENDING and is never shown publicly
// until a human with MODERATE_LISTING publishes it (§1.3's human-approval
// principle extended to reputation, not just price/content).
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id             String       @id @default(cuid())
  organizationId String
  bookingId      String       @unique
  // Denormalized at submission time from the booking's quote/departure
  // template — lets the public marketplace query reviews by template
  // without joining back through Booking -> Quote/Departure every time.
  tourTemplateId String?
  reviewerName   String
  rating         Int // 1-5
  title          String?
  body           String?
  status         ReviewStatus @default(PENDING)
  operatorReply  String?
  moderatedById  String?
  moderatedAt    DateTime?
  createdAt      DateTime     @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  tourTemplate TourTemplate? @relation(fields: [tourTemplateId], references: [id])
  moderatedBy  User?         @relation(fields: [moderatedById], references: [id])

  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Automation (§6, §9, §7 Phase 4) — AI governance. Every AI-drafted output
// sits here as DRAFTED and can never affect price, published content, or a
// confirmed booking until a human explicitly APPROVEs it (§1.3, §9) — the
// approval itself, who made it and when, is retained on this same row
// rather than only in audit_log, so the provenance travels with the draft.
// ---------------------------------------------------------------------------

enum AiJobKind {
  ITINERARY_DRAFT
  PROPOSAL_REWRITE
  TRANSLATION
  FEE_EXTRACTION
  NEWS_SUMMARY
  REPLY_DRAFT
}

enum AiJobApprovalStatus {
  DRAFTED
  APPROVED
  REJECTED
}

model AiJob {
  id            String              @id @default(cuid())
  organizationId String
  kind          AiJobKind
  status        AiJobApprovalStatus @default(DRAFTED)
  prompt        String
  model         String // provider/model identifier actually used — §9 provenance
  output        Json // the raw drafted content, never applied anywhere until approved
  requestedById String?
  decidedById   String?
  decidedAt     DateTime?
  resultEntityType String? // what approving this created, e.g. "TourTemplate"
  resultEntityId    String?
  // Which enquiry this job is for — only set for request-scoped kinds like
  // REPLY_DRAFT; ITINERARY_DRAFT isn't tied to any one request.
  requestId     String?
  createdAt     DateTime            @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User?           @relation("AiJobRequestedBy", fields: [requestedById], references: [id])
  decidedBy    User?           @relation("AiJobDecidedBy", fields: [decidedById], references: [id])
  request      EnquiryRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind, status])
  @@map("ai_jobs")
}

// ---------------------------------------------------------------------------
// Platform (§6) — integrations, audit log
// ---------------------------------------------------------------------------

// Admin-configurable provider credentials (§4.9, §11) — resolves the "ask
// before choosing a payment provider" question by making provider choice
// and credentials something an admin adds after launch, from the Admin
// Portal, rather than a build-time decision baked into the code.
//
// `secrets` (API keys, tokens, webhook signing secrets) is write-only from
// the API's perspective: IntegrationsService never returns its contents
// once saved, only whether it's been set. `config` holds non-secret fields
// (account IDs, phone numbers, from-address) that are safe to display back.
model Integration {
  id             String              @id @default(cuid())
  organizationId String
  provider       String // IntegrationProvider enum value from @safaribrain/shared
  category       String // IntegrationCategory enum value — denormalized for filtering
  displayName    String
  enabled        Boolean             @default(false)
  config         Json                @default("{}")
  secrets        Json                @default("{}")
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@map("integrations")
}

// ---------------------------------------------------------------------------
// Platform (§6) — audit log
// ---------------------------------------------------------------------------

// organizationId is required (not derived from actor, since a public
// proposal-token action — accept/request-changes — has no actor at all) so
// an admin can pull "everything that happened in my org" as one scoped
// query when troubleshooting a user's report — §9 "every AI/consequential
// action... retains... reviewer decision", extended here to give a human
// admin the same visibility for support purposes.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String // e.g. "quote.approve", "quote.accept"
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("audit_log")
}
